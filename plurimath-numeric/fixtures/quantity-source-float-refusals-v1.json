          "operator": "*",
          "left": {
            "type": "variable",
            "name": "x"
          },
          "right": {
            "type": "variable",
            "name": "y"
          }
        },
        "bindings": {
          "x": {
            "value": {
              "binary64": "7fefffffffffffff"
            },
            "unit": "m"
          },
          "y": {
            "value": "2",
            "unit": "s"
          }
        }
      },
      "source": {
        "id": "multiply-overflow",
        "outcome": "error",
        "class": "Plurimath::Errors::Evaluation::InvalidBindingError",
        "message": "wrong value for variable `quantity magnitude` (given Float, expected a real number)"
      },
      "expected_code": "InvalidBindingError"
